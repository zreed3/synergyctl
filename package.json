{
  "name": "synergyctl",
  "version": "0.1.0",
  "description": "Guardrailed CLI for the Synergy Wholesale SOAP API.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "synergyctl": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "skills",
    ".claude"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "smoke": "node dist/bin.js --json doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "smol-toml": "^1.4.2",
    "soap": "^1.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
